{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "thaliwise-api": {
      "root": "backend",
      "framework": "fastapi",
      "buildCommand": "pip install -r requirements.txt"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "thaliwise-api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
